# ============================================================
# SURVEYOR — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ---------- Application ----------
APP_NAME=SURVEYOR
# FINDING-013: production is now the default posture for a plain
# `cp .env.example .env` — set this to `development` yourself as a
# deliberate, explicit opt-out for local work. A missing/placeholder/short
# SECRET_KEY is rejected unconditionally (previously that check — and the
# AUTH_ENABLED fail-closed check below — only ran when APP_ENV was not
# "development", which is exactly the value this file shipped and defaulted
# to, with SECRET_KEY empty. An empty string is a valid HS256 key.).
APP_ENV=production
# FINDING-002 / FINDING-013: leave this empty and generate a strong, unique
# value — e.g. `openssl rand -hex 32` (scripts/install.sh does this for
# you). The app refuses to start with a missing/placeholder/short (<32
# char) SECRET_KEY in every environment except APP_ENV=development, where a
# random ephemeral key is generated for the process instead (logged loudly;
# does not survive a restart).
SECRET_KEY=
# FINDING-004: DEBUG only controls SQLAlchemy statement echoing now (CORS
# is controlled separately below). Leave false outside local development.
DEBUG=false

# FINDING-004: comma-separated exact origins allowed to call this API from
# a browser with credentials, e.g.:
#   CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
# Leave empty (default) to disable cross-origin browser access entirely —
# same-origin deployments behind Caddy (the default docker-compose setup)
# do not need this set.
CORS_ALLOWED_ORIGINS=

# ---------- PostgreSQL ----------
POSTGRES_USER=surveyor
# FINDING-011: leave this empty and generate a strong, unique value — e.g.
# `openssl rand -hex 24` (scripts/install.sh does this for you). The app
# refuses to start with a missing/placeholder POSTGRES_PASSWORD in every
# environment, and `docker compose up` fails closed the same way it already
# does for REDIS_PASSWORD below.
POSTGRES_PASSWORD=
POSTGRES_DB=surveyor
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ---------- Redis ----------
# FINDING-006: REDIS_PASSWORD is passed by docker-compose.yml to
# `redis-server --requirepass` AND used there to build the backend
# container's REDIS_URL for you (docker-compose.yml `backend.environment`
# overrides the REDIS_URL below when running via `docker compose up`).
# scripts/install.sh generates a strong value for fresh installs. Leaving
# it empty causes `docker compose up` to fail closed rather than start
# Redis without a password.
REDIS_PASSWORD=
# Only used directly when NOT running via docker-compose (e.g. running the
# backend locally against a Redis on localhost) — set the password inline:
#   REDIS_URL=redis://:your-redis-password@localhost:6379/0
REDIS_URL=redis://redis:6379/0

# ---------- AI Providers ----------
# At minimum, configure one LLM provider.

# OpenAI (also used for Realtime API in Path A)
OPENAI_API_KEY=

# Optional: route every OpenAI call through the EU regional endpoint
# (eu.api.openai.com) so customer content stays in the EEA region.
# Requires that the OpenAI project tied to your API key has data-residency
# enabled and a Modified Abuse Monitoring or Zero Data Retention amendment
# in place. See https://developers.openai.com/api/docs/guides/your-data
OPENAI_USE_EU=false

# Deepgram (Speech-to-Text)
DEEPGRAM_API_KEY=

# ElevenLabs (Text-to-Speech)
ELEVENLABS_API_KEY=

# Cartesia (Text-to-Speech, shown when configured)
CARTESIA_API_KEY=

# ---------- Telephony (Optional) ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ---------- Anthropic (Claude text models) ----------
ANTHROPIC_API_KEY=

# ---------- Custom LLM (LiteLLM / OpenAI-compatible) ----------
# Used when an agent's LLM model starts with "custom/<model>".
# Works with anything that speaks the OpenAI Chat Completions protocol,
# including a LiteLLM proxy:
#   - OpenRouter:  URL = https://openrouter.ai/api/v1   (then use e.g. custom/openrouter/anthropic/claude-sonnet-4-6)
#   - Groq:        URL = https://api.groq.com/openai/v1
#   - Mistral:     URL = https://api.mistral.ai/v1
#   - DeepInfra:   URL = https://api.deepinfra.com/v1/openai
#   - Together AI: URL = https://api.together.xyz/v1
#   - LiteLLM proxy / vLLM / Ollama / TGI on your own infra
OPENAI_COMPATIBLE_LLM_URL=
OPENAI_COMPATIBLE_LLM_API_KEY=

# ---------- Caddy ----------
# Domain for production SSL. Use localhost for local development.
# FINDING-003: also used by the backend to build the Twilio media-stream
# <Stream> callback URL and to validate inbound Twilio webhook signatures —
# set this to your real, internet-facing domain before configuring a
# Twilio phone number.
DOMAIN=localhost

# ---------- Voice audio recording storage (Optional) ----------
# Per-agent toggle (Store interview audio) in the agent form. Web voice only.
AUDIO_STORAGE_BACKEND=local
AUDIO_STORAGE_LOCAL_PATH=/data/oasis-recordings
# S3-compatible storage (set AUDIO_STORAGE_BACKEND=s3)
AUDIO_S3_BUCKET=
AUDIO_S3_PREFIX=oasis-recordings
AUDIO_S3_REGION=us-east-1
AUDIO_S3_ACCESS_KEY_ID=
AUDIO_S3_SECRET_ACCESS_KEY=
# Optional MinIO/custom endpoint
AUDIO_S3_ENDPOINT_URL=

# ---------- Authentication ----------
# FINDING-001: secure by default. AUTH_ENABLED=false is only permitted when
# APP_ENV=development — the app refuses to start with auth disabled in any
# other environment.
AUTH_ENABLED=true
AUTH_USERNAME=admin
# FINDING-005: prefer AUTH_PASSWORD_HASH — an Argon2id hash of the admin
# password, generated by scripts/install.sh (which hashes it inside the
# backend's own container image so Argon2 need not be installed on the
# host, and pipes it over stdin so it never appears in `ps`/`docker top`/
# `docker inspect`) or manually via:
#   docker run --rm -i --entrypoint python oasis-backend -c \
#     "import sys; from app.security import hash_password; print(hash_password(sys.stdin.read().rstrip(chr(10))))" <<< "your-password"
AUTH_PASSWORD_HASH=
# Deprecated migration path: plaintext password, only used when
# AUTH_PASSWORD_HASH is unset. Stored and logged as a warning on every use —
# do not set this on a new install (scripts/install.sh never does).
AUTH_PASSWORD=

# ---------- Google AI (Gemini Live) ----------
GOOGLE_API_KEY=

# ---------- Scaleway (Optional) ----------
SCALEWAY_SECRET_KEY=
SCALEWAY_PROJECT_ID=
SCALEWAY_API_URL=https://api.scaleway.ai/v1

# ---------- Azure OpenAI (Optional) ----------
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=

# ---------- GCP Vertex AI (Optional) ----------
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
GCP_API_KEY=

# ---------- Custom STT/TTS (LiteLLM / OpenAI-compatible, optional) ----------
# Point these at any OpenAI-compatible STT/TTS server — a LiteLLM proxy,
# Speaches (faster-whisper), Kokoro, Piper, LocalAI, etc. Select the
# "Custom / Self-Hosted" provider in the agent form to use them.
SELF_HOSTED_STT_URL=
SELF_HOSTED_STT_API_KEY=
SELF_HOSTED_STT_MODEL=whisper-1
SELF_HOSTED_TTS_URL=
SELF_HOSTED_TTS_API_KEY=
SELF_HOSTED_TTS_MODEL=tts-1

# ---------- Embeddings / RAG (Optional) ----------
# Leave empty to use OpenAI's text-embedding-3-small (requires OPENAI_API_KEY).
# Set EMBEDDING_API_URL to use any OpenAI-compatible embedding server instead.
# NOTE: The DB schema expects 1536-dimensional vectors. If your model outputs
# a different dimension, you'll need a database migration.
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# ---------- Egress guard (Optional, self-hosted providers only) ----------
# FINDING-007: plain http to a private (RFC1918/loopback-adjacent) endpoint
# — OPENAI_COMPATIBLE_LLM_URL, SELF_HOSTED_STT_URL, SELF_HOSTED_TTS_URL,
# EMBEDDING_API_URL, AZURE_OPENAI_ENDPOINT, AUDIO_S3_ENDPOINT_URL — is only
# allowed when the host is listed here. Leave empty (default) to require
# https for all of the above; add hostnames/IPs/CIDRs you run yourself,
# comma-separated, e.g.:
#   EGRESS_ALLOWED_PRIVATE_HOSTS=my-litellm,10.0.5.0/24,192.168.1.50
EGRESS_ALLOWED_PRIVATE_HOSTS=

# ---------- Trusted reverse proxy (Advanced) ----------
# FINDING-015: login/lockout rate limiting, the Twilio webhook/WebSocket
# rate limits, and authentication audit log lines all key on the request's
# client address. Behind docker-compose's Caddy that address is always
# Caddy's own — this setting tells the backend which peer address(es) it may
# trust an X-Forwarded-For header from (comma-separated IPs/CIDRs). The
# default matches the fixed subnet docker-compose.yml assigns to
# `oasis_net`; only change this if you run without docker-compose, put
# another proxy in front of Caddy, or have edited that subnet.
TRUSTED_PROXY_IPS=172.28.0.0/24
